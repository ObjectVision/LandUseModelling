// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
//                 Configuration Land Use Scanner - Student Edition                     //
//                          using GeoDMS version 14.14 or newer                         //
//                                                                                      //
//                           Vrije Universiteit Amsterdam                               //
//                               July 2004 - June 2024                                  //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
// This DMS-file is being referred to by Demo.dms                                       //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
// In this configurationfile the units are defined                                      //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////

container Units : IsHidden = "true"
{
	unit<Float64> Sec:             = BaseUnit('sec', Float64);
	unit<Float64> Min:             = 60 * sec,         cdf = "Classifications/Min_7k/Classes";
	
	unit<Float64> Meter:           = BaseUnit('m', Float64), cdf = "Classifications/Altitude8K/Classes";
	unit<Float64> Km:              = 1000.0 * Meter,         cdf = "Classifications/Km_7k/Classes";
	unit<int32>   cm:              = int32(0.01 * Meter);
	unit<Float64> Dm:              =    0.1 * Meter;
	unit<Float64> Year:            = BaseUnit('Yr', Float64);
	unit<Float64> Meter2:          = Meter * Meter;
	unit<Float64> Ha:              = 10000.0 * Meter * Meter, cdf = "Classifications/landuseHaK/Classes";
	unit<Float64> HaDiff:          = Ha,                      cdf = "Classifications/HaChangeK/Classes";

	unit<Float64> claimHa:         = Ha, cdf = "Classifications/ClaimHa9K/Classes";
	unit<Float64> claimHa2:        = claimHa * claimHa;

	unit<Float64> DemandUnit:     = BaseUnit('ClaimDemand', Float64), Descr = "used for Aj balancing Factor";
	unit<Float64> BcUnit:         = Ha / DemandUnit, Descr = "used for Bj balancing Factor";
	unit<Float64> Ratio:          = 1.0 * Ha / Ha,           cdf = "Classifications/Ratio6k/Classes";
	unit<Float64> Percent:        = 100.0 * Ha / Ha,         cdf = "Classifications/Percentage13K/Classes";
	unit<Float64> Eur:            = BaseUnit('EURO', Float64);
	unit<Float64> kEur:           = 1000.0 * Eur;
	unit<Float64> mEur:           = 1000.0 * kEur;
	unit<Float64> Eur_Ha:         = Eur / Ha;
	unit<Float64> kEur_Ha:        = 1000.0 * Eur_Ha;
	unit<Float64> mEur_Ha:        = 1000.0 * kEur_Ha;
	unit<Float64> Eur_M2:         = Eur / Meter2,                cdf = "Classifications/Eur_M2_15K/Classes";
	unit<Float64> M2_Eur:         = 1.0 / Eur_M2;
	unit<Float64> mEur_yr:        = mEur / Year;

	unit<Float64> NrPersons:      = BaseUnit('Inwoners', Float64), cdf  = "Classifications/NrInhabitants12K/Classes"
	{
		parameter<Float64> DotValuePalette: DialogType = "DotValuePalette", = 100.0;
	}
	
// ============ Artificial quantities, relate to EUR_M2
	unit<Float64> Potentiaal: cdf = "Classifications/Potentiaal10K/Classes";

// ============ Required ranges 
	unit<Int8>   ValuationRange : Range = "[-4, 5)" , cdf = "Classifications/ValuationRange10K/Classes";
	unit<Int8>   LossOrGain: Range = "[-1, 1)" , cdf = "Classifications/LossOrGain_Class/Classes";
	unit<UInt16> YearRange:     Range = "[1900, 2100)";
	unit<UInt16> IterRange:     nrofrows = 999;
	unit<Int16>  YearDiffRange: Range = "[-100, 100)";
	
	unit<uint32> ColorCoord;
}
