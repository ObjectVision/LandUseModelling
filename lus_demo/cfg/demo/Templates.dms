container Templates : isHidden = "True", Using = "Geography;Classifications"
{
	#include <Allocation_Procedures.dms>

	Template _Iter_AllocatedLand
	{
		parameter<ggEndogenous> ggEndogenousID;
		unit<uint32>            Adomain;
		///
		parameter<String>       ggName                   := lookup(ggEndogenousID, ggEndogenous/Name);
		attribute<Ha>           nrHaPerCell (ADomain)    := ='demand_factor * adjusted_demands/'+ggName, Descr = "Mcj = Bc * Aj * exp(betaFactor*Scj): see formula (3'''')";
		attribute<claimHa>      nrHaPerRegio (RegioUnit) := ='sum (nrHaPerCell, CaseData/Compacted/RegioGrids/'+ggName+')', Descr = "Tj= sum ( Mcj (* intensity))";
		parameter<claimHa>      nrHaAggr                 := sum(nrHaPerRegio);
		attribute<OperatorType> Operator  (RegioUnit)    := ='Additional_Claims/'+ggName+'/Operator';
		attribute<claimHa>      Deviation (RegioUnit)    := ='nrHaPerRegio - CaseData/TotalPeriodClaims/'+ggName;
		attribute<claimHa2>     SqrDevOrg (RegioUnit)    := sqr(Deviation);
		attribute<claimHa2>     SqrDev    (RegioUnit)    := Operator == 0[OperatorType]
																? Sqr(max_elem(0[claimHa], Deviation))
																: Operator == 2[OperatorType]
																	? Sqr(min_elem(0[claimHa], Deviation))
																	: Sqr(Deviation);
	}

	Template _IterTemplate
	{
		parameter<IterRange>  i : Descr = "Nr of iterations before this iteration";

		container currValue :=
			for_each_nedv(
				  ggEndogenous/Name
				, 'exp(betaFactor * MakeDefined(Additional_Claims/' + ggEndogenous/Name +'/logAj, 0[EUR_m2]))'
				, RegioUnit
				, float64
			),	Descr = "Aj: This will be initialized with InitialWeigths and then receives a copy of nextValue (Aj) for each iteration";

		unit<uint32> ADomain := .../Compacted/ADomain;

		container adjusted_demands :=
			for_each_nedv(
				  ggEndogenous/Name
				, 'MakeDefined(CaseData/Compacted/Demands/'+ggEndogenous/Name+' * lookup(CaseData/Compacted/RegioGrids/'+ggEndogenous/Name+', currValue/'+ggEndogenous/Name+'), 0[Units/DemandUnit])'
				, ADomain
				, float64
			), Descr = "Tcj = Aj * exp(beta*Scj): new demands based on given Aj (currValue)";

		attribute<DemandUnit> total_demand  (ADomain) := ='add('+asItemList('adjusted_demands/'+ggEndogenous/Name)+')', Descr = "Tc = sum(j, Tcj): total demand on input"; // for unused land category, add "+'value(1.0, DemandUnit)'"		
		attribute<BcUnit>     demand_factor (ADomain) := CaseData/Land/FreeLand[ADomain/org_rel] / total_demand, Descr = "Bc = Lc / Tc: see formula 6a";
		
		container allocated_land := 
			for_each_ne(
				ggEndogenous/Name
				, '_Iter_AllocatedLand('+String(id(ggEndogenous))+ '[ggEndogenous], Adomain)' 
			);

		parameter<claimHa>  TotalDeviation := ='sqrt(add('+asItemList('sum(allocated_land/'+ggEndogenous/Name+'/SqrDev)')+'))', Descr = "Sum of distances between claimed and allocated sums of ha per region";
		parameter<claimHa>  AllocatedAggr  := ='add('+asItemList('allocated_land/'+ggEndogenous/Name+'/nrHaAggr')+')';
		parameter<Bool>     IsConverged    := TotalDeviation < value(12000.0, Ha), Descr = "True if the total deviation of the claims in this iteration is below 12,000 ha. The loop does not stop on it: GeoDMS always runs all NrOfIterations iterations.";

		container nextValue :=
			for_each_nedv(
				  ggEndogenous/Name
				, 'claim_corrF32(CaseData/TotalPeriodClaims/'+ggEndogenous/Name+'[float32] * currValue/'+ ggEndogenous/Name+'[float32], allocated_land/'+ggEndogenous/Name+'/nrHaPerRegio[float32], Additional_Claims/'+ggEndogenous/Name+'/Operator)[float64]'
				, RegioUnit
				, float64
			), Descr    = "Aj' = Aj * Dj/Tj: see formula (6b')";
	}
	
	Template Claims_per_Scenario_T
	{
		parameter<string> scenario_name_short;
		///

		container per_LU_type := 
			for_each_ne(
				/Classifications/ggEndogenous/name
				, 'Templates/Claims_Per_LU_T('+quote(/Classifications/ggEndogenous/name)+', RegioUnit/per_domain)'
			)
		{
			container Additional_Claims // this container provides an overview of the claims for demo users that do not use administrator mode
			{
				attribute<claimHa>      residential (RegioUnit) := ../residential/Claim;
				attribute<claimHa>      industrial  (RegioUnit) := ../industrial/Claim;
				attribute<claimHa>      recreation  (RegioUnit) := ../recreation/Claim;
				attribute<claimHa>      nature      (RegioUnit) := ../nature/Claim;
				attribute<claimHa>      agriculture (RegioUnit) := ../agriculture/Claim;
				attribute<claimHa>      buildinglot (RegioUnit) := ../buildinglot/Claim;
			}

			container Provincie_Balance : Descr = "Keeps the net claim of each province at the share of its landsdeel in proportion to its current endogenous area, so that a province gets no more net claim than its landsdeel has relative to its free land."
			{
				attribute<claimHa> Endogenous_Landsdeel (RandstadIntermediatePeripheral) := ='add('+AsItemList('../'+/Classifications/ggEndogenous/name+'/Current_RandstadIntermediatePeripheral')+')';
				attribute<claimHa> Endogenous_Provincie                      (Provincie) := ='add('+AsItemList('../'+/Classifications/ggEndogenous/name+'/Current_Provincie')+')';
				attribute<claimHa> Net_Landsdeel        (RandstadIntermediatePeripheral) := ='add('+AsItemList('../'+/Classifications/ggEndogenous/name+'/Claim_RandstadIntermediatePeripheral')+')';
				attribute<claimHa> Net_Provincie                             (Provincie) := Net_Landsdeel[Provincie/Landsdelen_rel] * (Endogenous_Provincie / Endogenous_Landsdeel[Provincie/Landsdelen_rel]);
				attribute<claimHa> ByShare_Provincie                         (Provincie) := ='add('+AsItemList('../'+/Classifications/ggEndogenous/name+'/ClaimByShare_Provincie')+')';
			}
		}
	}
	
	Template Claims_per_LU_T
	{
		parameter<string>    lu_name;
		attribute<RegioUnit> Regios (domain);
		///
		
		attribute<OperatorType> Operator (RegioUnit) := const(1, RegioUnit, OperatorType);
		attribute<EUR_M2>       logAj    (RegioUnit) := const(0, RegioUnit, Eur_m2);

		attribute<claimHa>      Current_RandstadIntermediatePeripheral (RandstadIntermediatePeripheral) := ='sum(Current_situation/current_landuse/'+lu_name+', RandstadIntermediatePeripheral/per_domain)';
		attribute<claimHa>      Claim_RandstadIntermediatePeripheral   (RandstadIntermediatePeripheral) := ='rjoin(RandstadIntermediatePeripheral/RstIntPer, Read_Excel/'+lu_name+'/RstIntPer[uint32], Read_Excel/'+lu_name+'/'+scenario_name_short+'[claimHa])', Descr = "The claims per landsdeel, joined on the code RstIntPer and not on the order of the rows.";
		attribute<claimHa>      Total_RandstadIntermediatePeripheral   (RandstadIntermediatePeripheral) := Current_RandstadIntermediatePeripheral + Claim_RandstadIntermediatePeripheral;

		attribute<claimHa>      Current_Provincie                                           (Provincie) := ='sum(Current_situation/current_landuse/'+lu_name+', Provincie/per_domain)';
		attribute<claimHa>      ClaimByShare_Provincie                                      (Provincie) := Claim_RandstadIntermediatePeripheral[Provincie/Landsdelen_rel] * (Current_Provincie / Current_RandstadIntermediatePeripheral[Provincie/Landsdelen_rel]), Descr = "The claim per landsdeel divided over its provinces in proportion to the current area of this land-use type.";
		attribute<claimHa>      Claim_Provincie                                             (Provincie) := =lu_name == ModelParameters/Advanced/BalancingType_Provincie
																														? '../Provincie_Balance/Net_Provincie - (../Provincie_Balance/ByShare_Provincie - ClaimByShare_Provincie)'
																														: 'ClaimByShare_Provincie'
		, Descr = "The claim per province. The balancing type takes the difference between the net claim of the province and the claims of the other types, so the claims per type still add up to those of the landsdeel.";
		attribute<claimHa>      Total_Provincie                                             (Provincie) := Current_Provincie + Claim_Provincie;

		attribute<claimHa>      Current                                                     (RegioUnit) := ='Current_'+ModelParameters/RegioUnit_str;
		attribute<claimHa>      Claim                                                       (RegioUnit) := ='Claim_'+ModelParameters/RegioUnit_str;
		attribute<claimHa>      Total                                                       (RegioUnit) := ='Total_'+ModelParameters/RegioUnit_str;
	}
}
