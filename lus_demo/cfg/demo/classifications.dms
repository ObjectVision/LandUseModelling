			rgb(255,  0,  0),rgb(255,104,104),rgb(255,149,149),rgb(255,206,206),rgb(255,236,236),rgb(219,219,219)
		,	rgb(200,240,200),rgb(150,200,150),rgb( 89,172, 89),rgb( 29,112, 29),rgb(  0, 64,  0)
