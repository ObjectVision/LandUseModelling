// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
//                 Configuration Land Use Scanner - Student Edition                     //
//                          using GeoDMS version 7.130 or newer                         //
//                                                                                      //
//                           Vrije Universiteit Amsterdam                               //
//                               July 2004 - January 2024                               //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
// This DMS-file is being referred to by Present.dms                                    //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////
//                                                                                      //
// In this configurationfile the dms-trees for other maps of current landuse            //
// are worked out:                                                                      //
//                                                                                      //
// Dit is de file waarin zijn opgenomen de bomen mbt                                    //
// - fysische omgeving                                                                  //
// - infrastructuur                                                                     //
// - sociaal economische factoren (nog te definieren)                                   //
//                                                                                      //
// ///////////////////////////////////////////////////////////////////////////////////////
container Thematic_maps
{
	container Residential_location
	{
		container Impl : isHidden = "True"
		{
			attribute<uint16> urban_attractiveness (rdc_100m)
			:	Source      = "Urban attractiveness index 2024: describes the presence of three types of urban amenities: historic buildings; shops; hotels, restaurants and other catering establishments. The numbers of units per amenity type are counted per 100 m grid cell, rescaled to a maximum value of 0.33 per type, added up and averaged out over a 5 km radius"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/Residential/UAI_2024.tif";
			
			attribute<Percent> attractive_surroundings (rdc_500m) 
			:	Source      = "Landscape attractiveness: MNP/RIVM"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/Residential/AttractivitySurroundings.tif"
			, 	cdf = "Classifications/Percentage10k/Classes";
		}
		
		attribute<Percent> urban_attractiveness       (domain) := float32(Impl/urban_attractiveness)[rdc_100m/domain_rel] * 1[Percent], cdf = "Classifications/Percentage10k/Classes", Descr = "Index expressing relative richness in three types of amenities: historic buildings; shop and hotels & catering outlets (2024)";
		attribute<Percent> attractive_surroundings    (domain) := Impl/attractive_surroundings[domain/rdc_500m_rel], Descr = "Landscape attractiveness as perceived by the general public", URL = "https://www.clo.nl/indicatoren/nl102305-belevingskaart-van-het-nederlandse-landschap";
	}

	container Accessibility: Descr = "Maps with a.o. accessibility by road and with euclidean distances"
	{
		container impl : isHidden = "True"
		{
			attribute<uint16> dist_train_station (rdc_100m)
			:	Label       = "Distance to nearest train station (2019)"
			,	Descr       = "Euclidean distance to nearest regular train station"
			,	Source      = "Railway stations point dataset from NS; Calculations: Jip Claassens (Vrije Universiteit; Object Vision, 2020)"
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/DistTo_Trainstations_meter_2019.tif";
			
			attribute<uint8> dist_airports (rdc_100m)
			:	Label       = "Distance to nearest main airport (2019)"
			,	Descr       = "Euclidean distance (in kilometers) to nearest main (top 5) airport"
			,	Source      = "Airport polygon dataset from BRT; Calculations: Jip Claassens (Vrije Universiteit; Object Vision, 2020)"
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/DistTo_Airports_2019_Top5_BRT_km.tif";
			
			attribute<uint8> dist_seaports (rdc_100m)
			:	Label       = "Distance to nearest seaport (2022)"
			,	Descr       = "Euclidean distance (in kilometers) to nearest seaport"
			,	Source      = "Seaport polygon dataset from a selection of IBIS; Calculations: Jip Claassens (Vrije Universiteit; Object Vision, 2024)"
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/DistTo_Zeehavens_2022_IBIS_km.tif";
			
			attribute<uint16> dist_highway_entry (rdc_100m)
			:	Label       = "Distance to nearest highway entry (2018)"
			,	Descr       = "Euclidean distance to highway entries"
			,	Source      = "OpenStreetMap; Calculation: Jip Claassens (Vrije Universiteit; Object Vision, 2018)"
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/DistTo_highway_acces_exit_meter_2018.tif";

			attribute<uint16> dist_100kjobs (rdc_100m)
			:	Label       = "Distance to 100.000 Jobs"
			,	Source      = "Employment: LISA 2018; Calculation: Jip Claassens (Vrije Universiteit; Object Vision, 2020)"
			,	Descr       = "Minimum distance that needs to be travelled in order to reach 100.000 jobs in 2018. "
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/TraveltimeTo_100k_Jobs_2018.tif";
			
			attribute<uint16> traveltime_100000inh (rdc_100m)
			:	Label       = "Travel time to 100.000 inhabitants"
			,	Descr       = "Travel time to 100.000 inhabitants (CBS Vierkanten, 2017; OpenStreetMap, 2018); Calculations: Jip Claassens (Vrije Universiteit; Object Vision, 2018)"
			,	StorageName = "%projdir%/data/Current_situation/thematic_maps/accessibility/TraveltimeTo_100k_Inhabitants_2017.tif";
		}

		attribute<km>  Distance_to_airports             (domain) := Makedefined(impl/dist_airports[km]               , 999[km])[rdc_100m/domain_rel], Descr = "Euclidean distance to nearest airport (includes the 5 airports used for commercial passenger flights in 2019";
		attribute<km>  Distance_to_seaports             (domain) := Makedefined(impl/dist_seaports[km]               , 999[km])[rdc_100m/domain_rel], Descr = "Euclidean distance to nearest seaport (selection of 5 main ports for cargo from IBIS, 2022)";
		attribute<km>  Distance_to_trainstation         (domain) := Makedefined((impl/dist_train_station[Meter])[km] , 999[km])[rdc_100m/domain_rel], Descr = "Euclidean distance to nearest railway station (for passenger trains in 2019)";
		attribute<km>  Distance_to_highwayentry         (domain) := Makedefined((impl/dist_highway_entry[Meter])[km] , 999[km])[rdc_100m/domain_rel], Descr = "Euclidean distance to nearest highway entry (includes dual carriage and smaller highways from Open Street Map, 2018)";
		attribute<km>  Distance_to_100000_jobs          (domain) := Makedefined((impl/dist_100kjobs[meter])[km]      , 999[km])[rdc_100m/domain_rel], Descr = "Minimum distance that needs to be travelled in order to reach 100.000 jobs in 2018. ";
		attribute<min> Traveltime_to_100000_inhabitants (domain) := Makedefined((impl/traveltime_100000inh[sec])[min], 999[min])[rdc_100m/domain_rel], Descr = "Minimum car travel time to reach the 100,000th inhabitant in 2018.";
	}
	container Noise
	{
		container impl : isHidden = "True"
		{
			attribute<Percent> perc_opp_gt_50dba(rdc_100m)
			:	Descr       = "% opp > 50 db(A)"
			,	Source      = "Noise: RIVM lden from all sources 2022 (20250801). 10m map, calc rule: sum_uint32(lden >= 50[int16], rdc_10m/rdc_100m_rel)"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/noise/perc_opp_gt_50dba_20260120.tif"
			, cdf = "Classifications/Percentage10k/Classes";
		}
		
		attribute<Percent> perc_opp_gt_50dba       (domain) := Impl/perc_opp_gt_50dba[domain/rdc_100m_rel], Descr = "Fraction per cell with a noise level exceeding 50 dB(A) as determined by the Empara model (RIVM)";
	}

	container NatureLandscape
	{
		container impl: isHidden = "True"
		{
			attribute<Int32> altitude (rdc_500m)
			:	Descr       = "Hoogtekaart in dm"
			,	Source      = "AHN"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/NatureLandscape/altitude.tif";
			
			attribute<Ls_Qual4k> landscape_quality4K (rdc_500m)
			:	Source      = "Kwaliteit landschap: Alterra. derived from KELK model, see Roos-Klein Lankhorst et al., 2013"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/NatureLandscape/landscape_quality4k.tif";
			attribute<bool> WetSoil (rdc_100m)
			:	StorageName = "%projDir%/data/Current_situation/thematic_maps/NatureLandscape/TooWetSoil.tif"
			, 	URL         = "www.deltares.nl/expertise/publicaties/op-waterbasis-grenzen-aan-de-maakbaarheid-van-ons-water-en-bodemsysteem";
			attribute<bool> WeakSoil (rdc_100m)
			:	StorageName = "%projDir%/data/Current_situation/thematic_maps/NatureLandscape/TooWeakSoil.tif"
			, 	URL         = "www.deltares.nl/expertise/publicaties/op-waterbasis-grenzen-aan-de-maakbaarheid-van-ons-water-en-bodemsysteem";
			attribute<bool> SubsidenceProne (rdc_100m)
			:	StorageName = "%projDir%/data/Current_situation/thematic_maps/NatureLandscape/TooSubsidenceProneSoil.tif"
			, 	URL         = "www.deltares.nl/expertise/publicaties/op-waterbasis-grenzen-aan-de-maakbaarheid-van-ons-water-en-bodemsysteem";
		}

		attribute<Ls_Qual4k>      Landscape_quality     (domain) := MakeDefined(impl/Landscape_quality4K , 0[Ls_Qual4k])[domain/rdc_500m_rel], Descr = "Landscape values as defined by experts in 4 classes";
		attribute<Meter>          Altitude              (domain) := MakeDefined(impl/Altitude[dm] / 10.0[dm / Meter], 0[Meter])[domain/rdc_500m_rel];
		attribute<bool>           IsWetSoil             (domain) := impl/WetSoil[rdc_100m/domain_rel], Descr = "Presence of wet soils (groundwater within 30 cm of surface) where water logging is likely ";
		attribute<bool>           IsWeakSoil            (domain) := impl/WeakSoil[rdc_100m/domain_rel], Descr = "Presence of peaty, weak soils that limit agricultural use and require costly foundations for construction ";
		attribute<bool>           IsSubsidenceProne     (domain) := impl/SubsidenceProne[rdc_100m/domain_rel], Descr = "Presence of clay or peaty soil prone to subsidence of 10 cm or more in coming decades ";
	}
	container Safety: Descr = "Maps related to various safety issues"
	{
		container impl: isHidden = "True"
		{
			attribute<cm> waterdepth (rdc_25m)
			:	Label       = "Water depth following worst possible flood"
			,	Source      = "Deltares"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/safety/WaterDepth_cm.tif";

			attribute<Mercalli4K> earthquakes (rdc_25m)
			:	Descr       = "Earthquake zone (intensity on Mercalli scale)"
			,	URL         = "https://www.atlasleefomgeving.nl/kaarten"
			,	Source      = "Interprovinciaal overleg IPO, 2023"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/safety/Earthquakes_Mercalli4K_20260119.tif";

			attribute<bool> riskcontour_10_6 (rdc_25m)
			:	Descr       = "Dangerous sites with a risk contour of 10-6"
			,	Source      = "Besluit Externe Veiligheid Inrichtingen (BEVI) 2025"
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/safety/IsRiskcontour_10_6_20260119.tif";

			unit<uint32> NuclearPlantBorssele : nrofrows = 1
			{
				attribute<rdc_meter> geometry                   := const(point_xy(38910f, 383749f, rdc_meter),.);
				attribute<rdc_meter> geometry_buffer     (poly) := bg_buffer_point(geometry, 5000d, 16b);
				attribute<.>         per_25m          (rdc_25m) := poly2grid(geometry_buffer, rdc_25m);
				attribute<bool>      EvacuationZone   (rdc_25m) := IsDefined(geometry_buffer[per_25m]);
			}

			attribute<bool> dangerous_transport (rdc_100m)
			:	Label       = "Dangerous goods transport in undergound pipelines"
			,	Source      = "Ministry of Infrastructure and Waterworks: Registry of external safety 2024"
			,	url         = "https://www.atlasleefomgeving.nl/kaarten?config=3ef897de-127f-471a-959b-93b7597de188&layerFilter=Alle%20kaarten&use=piwiksectorcode&gm-x=150000&gm-y=460000&gm-z=3&gm-b=1673263665342,true,0.5;1673599662817,true,1;1673599705524,true,1"
			,	Descr       = "Buffer of 50m around pipelines."
			,	StorageName = "%projDir%/data/Current_situation/thematic_maps/safety/UndergroundPipelines_20260120.tif";
			
			attribute<FloodZonesK> FloodHazardZones (rdc_25m)
			:	StorageName = "%projDir%/data/Current_situation/thematic_maps/Safety/FloodHazardZones.tif"
			, 	Descr       = "combinatiekaart waarin LSG (totale lokaal schadegevaar; de schade die gemiddeld jaarlijks te verwachten is door overstromingen als er op die plaats een standaard eengezinswoning zou worden gebouwd) en LVG (lokaal verdrinkingsgevaar; 
								de gemiddelde kans per jaar voor een hypothetisch daar aanwezige persoon om op die plek door een overstroming te overlijden) zijn gecombineerd, als mogelijk hulpmiddel voor locatiekeuze en/of het vaststellen van bouwvereisten.";
		}
		
		attribute<Meter>       floodWaterdepth     (domain) := convert(impl/waterdepth, meter)[domain/rdc_25m_rel], cdf = "Classifications/Diepte8k/Classes";
		attribute<Mercalli4K>  earthquakes         (domain) := MakeDefined(impl/earthquakes[domain/rdc_25m_rel], Mercalli4K/v/none), Descr = "Location prone to earth quakes with different intensities (V, VI, VII, or VIII) on the Mercalli scale ";
		attribute<bool>        IsDangerousSite     (domain) := max_elem(impl/RiskContour_10_6, impl/NuclearPlantBorssele/EvacuationZone)[domain/rdc_25m_rel], Descr = "RiskContour_10_6 / Evac. zone Borssele";
		attribute<bool>        IsDangerousTransport (domain) := impl/Dangerous_transport[domain/rdc_100m_rel];
		attribute<FloodZonesK> FloodHazardZones    (domain) := modus(impl/FloodHazardZones, rdc_25m/domain_rel);
		attribute<bool>        HasFloodHazard      (domain) := FloodHazardZones >= FloodZonesK/v/moderate; //opties op volgorde: 'Nihil','Gering_20','Gering_200','Enigszins_gevaarlijk','Gevaarlijk','Zeer_gevaarlijk'
	}
}